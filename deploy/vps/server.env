# shellcheck shell=bash disable=SC2034,SC2317
# Committed, non-secret server config (deploy/vps). Never put a secret here: provision.sh
# generates the secrets on the server. Read it only by sourcing it with bash:
#   set -a; . deploy/vps/server.env; set +a
# provision.sh copies it to /etc/sefid/server.env, where sefid-cert reads it.

SERVER_HOST=2.144.23.111
SSH_USER=deploy
SERVER_HOSTNAME=sefid-prod-1

# preview: https://new.sefiddental.ir, not indexed. live: the apex and www, indexed (only after
# the client approves the switch). Switching is this one line, then the workflow actions
# provision and cert.
PHASE=preview

case "$PHASE" in
  preview)
    SITE_URL=https://new.sefiddental.ir
    DOMAINS="new.sefiddental.ir"
    ALLOW_INDEXING=false
    ;;
  live)
    SITE_URL=https://sefiddental.ir
    DOMAINS="sefiddental.ir www.sefiddental.ir"
    ALLOW_INDEXING=true
    ;;
  *)
    echo "server.env: PHASE must be preview or live, not \"$PHASE\"" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

# Let's Encrypt account e-mail (expiry notices). Empty: register without an e-mail.
LE_EMAIL=
# Heap limit of the app (docs/deploy.md 2.3). systemd caps the service at 2 GB (MemoryMax).
NODE_OPTIONS=--max-old-space-size=1024
