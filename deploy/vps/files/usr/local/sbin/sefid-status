#!/usr/bin/env bash
# Print the state of the site on this server: health, releases, units, the last 50 app log
# lines, disk, memory, certificate, last backup, pending security updates, reboot-required and
# the checks below. Read only. Exits 1 when /api/health does not answer 200.
#
#   sefid-status --check    only the checks: one line per failure, exit 1 when any fails
#                           (the watch workflow, docs/deploy.md 3.6)
set -Eeuo pipefail
# shellcheck source=SCRIPTDIR/../lib/sefid/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/sefid/common.sh"

need_root "$@"

# One "FAIL <what>: <why>" line per failed check; returns 1 when any failed.
checks() {
  local failed=0 now line age result code out size avail target
  now=$(date +%s)
  fail() {
    printf 'FAIL %s\n' "$*"
    failed=1
  }
  line=$(newest db 'sefid-*-nightly.dump')
  if [ -z "$line" ]; then
    fail "backup: no nightly dump in $SEFID_BACKUPS/db"
  else
    age=$(((now - ${line%% *}) / 3600))
    [ "$age" -lt 26 ] || fail "backup: the newest nightly dump is $age h old (limit 26 h): ${line#* }"
  fi
  result=$(cat "$SEFID_BACKUPS/last-nightly" 2>/dev/null || true)
  case $result in *' failed '*) fail "backup: the last nightly run failed: $result (sudo journalctl -u sefid-backup.service)" ;; esac
  if [ ! -e "$SEFID_CRON_OK" ]; then
    fail "cron: no successful tick since the server started (sudo journalctl -u sefid-cron.service)"
  else
    age=$((now - $(stat -c %Y "$SEFID_CRON_OK")))
    [ "$age" -le 300 ] || fail "cron: the last successful tick was $((age / 60)) min ago (limit 5 min; sudo journalctl -u sefid-cron.service)"
  fi
  # "size avail mount", once per file system that holds the system, app data or backups. df
  # exits 1 when one path is missing and still prints the others.
  out=$(df --output=size,avail,target -B1 / /var/lib/sefid /var/lib/postgresql "$SEFID_BACKUPS" 2>/dev/null |
    awk 'NR > 1 && !seen[$3]++') || true
  [ -n "$out" ] || fail "disk: df printed nothing"
  while read -r size avail target; do
    [ -n "$size" ] || continue
    [ "$((avail * 100))" -ge "$((size * 15))" ] ||
      fail "disk: $target has $((avail * 100 / size)) % free (limit 15 %)"
  done <<<"$out"
  if [ ! -e "$SEFID_ETC/tls/fullchain.pem" ]; then
    fail "certificate: $SEFID_ETC/tls/fullchain.pem is missing (run the action cert)"
  elif ! openssl x509 -in "$SEFID_ETC/tls/fullchain.pem" -noout -checkend $((14 * 86400)) >/dev/null; then
    fail "certificate: expires within 14 days ($(openssl x509 -in "$SEFID_ETC/tls/fullchain.pem" -noout -enddate)); certbot renews from 30 days: check certbot.timer"
  fi
  out=$(curl -sS --max-time 10 -w '\n%{http_code}' "$(app_origin)/api/health" 2>&1) || true
  code=${out##*$'\n'}
  [ "$code" = 200 ] || fail "health: /api/health on loopback answered HTTP ${code:-none}"
  return "$failed"
}

if [ "${1-}" = --check ]; then
  if checks; then echo "ok: backup, cron, disk, certificate and health"; else exit 1; fi
  exit 0
fi

section() { printf '\n===== %s =====\n' "$1"; }
healthy=0

section "health"
origin=$(app_origin)
out=$(curl -sS --max-time 10 -w '\n%{http_code}' "$origin/api/health" 2>&1) || true
printf '%s\nHTTP %s\n' "${out%$'\n'*}" "${out##*$'\n'}"
[ "${out##*$'\n'}" != 200 ] || healthy=1

section "releases"
current=$(readlink "$SEFID_ROOT/current" 2>/dev/null || echo none)
previous=$(readlink "$SEFID_ROOT/previous" 2>/dev/null || echo none)
echo "current: $current"
echo "previous: $previous"
cat "$SEFID_ROOT/current/release.json" 2>/dev/null && echo
ls -1 "$SEFID_ROOT/releases" 2>/dev/null || true

section "units"
systemctl status --no-pager --lines=0 sefid.service nginx.service postgresql.service || true
systemctl list-timers --no-pager 'sefid-*' certbot.timer apt-daily-upgrade.timer || true

section "last 50 lines of sefid.service"
journalctl -u sefid.service -n 50 --no-pager -o short-iso || true

section "disk and memory"
df -h / /var/lib/sefid /var/backups/sefid 2>/dev/null || df -h /
free -m

section "certificate"
if [ -e "$SEFID_ETC/tls/fullchain.pem" ]; then
  echo "file: $(readlink -f "$SEFID_ETC/tls/fullchain.pem")"
  openssl x509 -in "$SEFID_ETC/tls/fullchain.pem" -noout -subject -enddate -ext subjectAltName || true
else
  echo "none"
fi

section "last backup"
for kind in db media; do
  newest=$(find "$SEFID_BACKUPS/$kind" -maxdepth 1 -type f ! -name '*.part' \
    -printf '%T@ %TY-%Tm-%TdT%TH:%TM %s bytes %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d ' ' -f 2-) || true
  echo "$kind: ${newest:-none}"
done
for label in nightly pre-deploy manual; do
  echo "last $label run: $(cat "$SEFID_BACKUPS/last-$label" 2>/dev/null || echo 'none recorded')"
done
echo "all backups: $(du -sh "$SEFID_BACKUPS" 2>/dev/null | cut -f 1)"

section "updates"
security=$(apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep -c '^Inst .*-security' || true)
echo "pending security updates: $security (unattended-upgrades installs them nightly)"
if [ -f /run/reboot-required ]; then
  echo "reboot required by: $(tr '\n' ' ' </run/reboot-required.pkgs 2>/dev/null)"
  echo "unattended-upgrades reboots at 23:45 UTC when it installs updates."
else
  echo "no reboot required"
fi

section "checks (sefid-status --check, what the watch workflow alerts on)"
checks || true

[ "$healthy" = 1 ] || die "/api/health did not answer 200"
