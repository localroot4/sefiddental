# Sefid Dental: environment variables.
#
# Copy to `.env` for local development (`.env` is gitignored) and fill the secrets.
# `src/lib/env.ts` validates every value at start; in production (NODE_ENV=production at run
# time) a missing required value stops the server with "<NAME> missing: <fix>". In development
# and tests, a missing secret is derived from PAYLOAD_SECRET (an HMAC per name, one warning line
# each), so every process agrees on it.
#
# Columns in the comments: required where, default, B = read at build, R = read at run time.
# `next build` needs only a parseable DATABASE_URL and a non-empty PAYLOAD_SECRET.
# Never use a NEXT_PUBLIC_ prefix: client code receives configuration through server props.
# NODE_ENV is set by the tooling (next dev, next build, server.js); never set it here.

# ---------------------------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------------------------

# Public origin, no trailing slash, apex host (not www.). Payload serverURL, canonicals,
# sitemaps, robots, JSON-LD, form origin checks. Required in production. Default
# http://localhost:3000. R.
SITE_URL=http://localhost:3000

# Commit SHA of the running build: health endpoint, status view, logs. Required in production
# (the deploy step sets it; CI uses the workflow SHA). Default "dev". R.
GIT_SHA=dev

# ISO time of the build, shown on the status view. Optional. R.
BUILD_TIME=

# ---------------------------------------------------------------------------------------------
# Database and Payload
# ---------------------------------------------------------------------------------------------

# Always required (B: parse only, R). The scheme selects the adapter:
#   postgres://user:password@host:5432/db  or  postgresql://...  -> PostgreSQL (production)
#   file:./.data/dev.db                                           -> SQLite (tests, local)
# Any other scheme stops the start with an error.
DATABASE_URL=postgres://sefid:CHANGE_ME@127.0.0.1:5432/sefid_dev

# Drizzle schema push: false, 0, off or no turn it off; unset or blank = on outside production.
# Keep false for every migrated database (e2e, CI, staging, production, local production
# checks); set true only on a throwaway dev database. `npm run seed` defaults to false. Never mix
# push and migrations on one database. R.
DB_PUSH=false

# Signs Payload sessions. Always required (B: non-empty, R). At least 43 characters in
# production, one value per environment: `openssl rand -base64 48`. Secret.
PAYLOAD_SECRET=

# true only while creating the first admin on a fresh database; otherwise
# /giris/create-first-user and POST /api/users/first-register return 404. Default false. R.
ALLOW_FIRST_USER=false

# ---------------------------------------------------------------------------------------------
# Secrets for internal calls and forms (required in production; derived from PAYLOAD_SECRET in dev)
# Generate each with `openssl rand -base64 48` (CI: `openssl rand -hex 32`). Secret.
# ---------------------------------------------------------------------------------------------

# Bearer token of GET /api/cron/tick and of Payload's job runner (host crontab, every minute).
CRON_SECRET=

# Header x-internal-token on the proxy's calls to /api/internal/*.
INTERNAL_API_TOKEN=

# Origin the proxy uses to reach /api/internal/* on the same process, never the public origin.
# Default http://127.0.0.1:${PORT}. R.
INTERNAL_ORIGIN=

# HMAC key for hashed client IPs (audit log, bookings) and SMS cap destinations. A change
# resets the SMS cap.
IP_HASH_SECRET=

# Signs the form session and time tokens (booking and emergency forms).
FORM_TOKEN_SECRET=

# Previous FORM_TOKEN_SECRET during a rotation: verify only, never used to sign. Optional.
FORM_TOKEN_SECRET_PREVIOUS=

# Lifetime of a form time token in seconds. Default 7200. R.
FORM_TOKEN_TTL_SECONDS=7200

# ---------------------------------------------------------------------------------------------
# Request handling
# ---------------------------------------------------------------------------------------------

# true only on production: robots.txt allows crawling, no X-Robots-Tag noindex, sitemaps list
# URLs. Default false (staging never reaches search engines). R.
ALLOW_INDEXING=false

# true behind the platform proxy or nginx: trust X-Forwarded-Proto, X-Forwarded-For and an
# incoming X-Request-Id. Default false. R.
# Production behind the host's proxy needs true: with false every visitor shares one rate-limit
# bucket ('unknown'), so /api/form-session allows 60 requests per minute for the whole site and
# sign-in allows 10 per 15 minutes for everyone.
TRUST_PROXY_HEADERS=false

# Number of trusted proxies in front of the app; the client IP is the N-th X-Forwarded-For hop
# from the right. Used only when TRUST_PROXY_HEADERS=true. Default 1. R.
TRUSTED_PROXY_HOPS=1

# on: every public request gets the 503 maintenance page (health and admin keep working).
# Default off. R.
MAINTENANCE_MODE=off

# Retry-After seconds on the 503 maintenance response. Default 900. R.
MAINTENANCE_RETRY_AFTER=900

# Content-Security-Policy mode for public pages: enforce or report-only. Default enforce. R.
CSP_MODE=enforce

# Content-Security-Policy mode for the admin (/giris): enforce or report-only. Default enforce (the admin
# flows reported no violation under report-only). report-only is a debugging switch. R.
CSP_ADMIN_MODE=enforce

# 1 enables the /qa/* routes (Lighthouse and screenshot targets). CI and local QA only, never
# production. Default unset. R.
QA_ROUTES=

# Logger level: fatal, error, warn, info, debug, trace. Default info. R.
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------------------------

# Absolute directory for uploads, outside .next (a rebuild must not delete media). Required
# in production and e2e. Default <repo>/media in development. R.
MEDIA_DIR=

# Origin of object storage or a CDN when media is not served from SITE_URL: CSP img-src and
# media-src, robots Allow line. Optional. R.
MEDIA_PUBLIC_ORIGIN=

# S3-compatible object storage. Empty S3_BUCKET = local disk under MEDIA_DIR. R.
S3_BUCKET=
S3_ENDPOINT=
# Default "default".
S3_REGION=default
# true for providers that need path-style URLs. Default false.
S3_FORCE_PATH_STYLE=false
# Required when S3_BUCKET is set. Secret.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------
# E-mail (password reset). Empty SMTP_HOST = reset e-mails are not sent (the log shows only the
# recipient); a locked-out admin uses `npm run reset-admin -- <email>` (scripts/reset-admin.ts).
# ---------------------------------------------------------------------------------------------

SMTP_HOST=
# Default 587 (STARTTLS); 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USER=
# Secret.
SMTP_PASS=
# Sender address. Required when SMTP_HOST is set.
SMTP_FROM=

# ---------------------------------------------------------------------------------------------
# Notifier credentials. The `notifier` global in the admin holds the switches and recipients; a
# channel sends only when its switch is on and its values below are set. Optional. R.
# ---------------------------------------------------------------------------------------------

# Telegram bot token (<digits>:<key>). Outbound to api.telegram.org, usually filtered in Iran.
# Secret.
TELEGRAM_BOT_TOKEN=
# Farapayamak panel for SMS; both or neither. The SMS driver is a scaffold until SMS is approved.
FARAPAYAMAK_USERNAME=
# Secret.
FARAPAYAMAK_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Process (set by the host, not by the app)
# ---------------------------------------------------------------------------------------------

# Socket of the standalone server. Defaults 3000 and the Next default. To bind loopback only, use
# HOSTNAME=localhost, never 127.0.0.1 or ::1: Next 16.4 then proxies every rewrite to itself and
# Persian detail pages answer 500 (the app refuses to start with a loopback IP).
# PORT=3000
# HOSTNAME=0.0.0.0

# Production: UTC. Code never depends on it (test:tz runs three zones).
# TZ=UTC

# Production on a 1 GB host: --max-old-space-size=640 (tune after measuring RSS). Unset in dev
# and CI unless the build runs out of heap.
# NODE_OPTIONS=--max-old-space-size=640

# CI and production: 1.
# NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------------------------
# Backups (deploy phase, held until the hosting path is approved)
# ---------------------------------------------------------------------------------------------

# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------
# Tests and tooling only (never in production)
# ---------------------------------------------------------------------------------------------

# Proxy config memo lifetime in ms. Default 30000; tests lower it.
# PROXY_CONFIG_TTL_MS=30000

# Form-session requests per minute per client. Default 60; the e2e servers raise it, because
# every test shares one localhost client.
# FORM_SESSION_RATE_LIMIT=60

# Integration tests on PostgreSQL (migrated first, DB_PUSH=false). Unset = SQLite temp files.
# INT_DATABASE_URL=postgres://sefid:CHANGE_ME@127.0.0.1:5432/sefid_int

# Local Chromium for Playwright in the cloud container; unset in CI.
# PW_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Chrome for Lighthouse CI (container path above; CI uses Playwright's browser).
# CHROME_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# End-to-end, bundle check and Lighthouse: the migrated and seeded database of the standalone
# server (default file:./.data/e2e.db, built by `npm run db:e2e`) and its port (default 3000;
# the maintenance server listens on E2E_PORT+1, the ALLOW_INDEXING=true server on E2E_PORT+2).
# E2E_DATABASE_URL=file:./.data/e2e.db
# E2E_PORT=3000

# Set by the tooling: QA_SCREENSHOTS, LHCI_THEME, CI, PAYLOAD_FORCE_DRIZZLE_PUSH. Set by Next
# and Payload, never by us: NEXT_PHASE, NEXT_RUNTIME, VITEST_POOL_ID, PAYLOAD_MIGRATING.
