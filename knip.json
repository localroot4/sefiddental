{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "lighthouserc.cjs",
    "scripts/*.mjs",
    "src/seed/index.ts",
    "scripts/reset-admin.ts",
    "scripts/first-admin.ts",
    "tests/setup/e2eUsers.ts",
    "tests/fixtures/qa-seed.ts",
    "deploy/cpanel/app.cjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "*.{ts,mts,cjs,mjs}",
    "deploy/**/*.{cjs,ts}"
  ],
  "ignoreBinaries": ["openssl"],
  "ignoreExportsUsedInFile": true
}
